# ==============================================================================
# Production Environment Configuration for Hostinger VPS (Docker + Nginx)
# Copy this file to `.env` on your VPS before running `docker compose up -d --build`
# ==============================================================================

# --- MySQL 8.0 Database (Docker `db` service) ---
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=xm_trading_v2
MYSQL_USER=aibrain_user
MYSQL_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD

# --- Security (CRITICAL: Generate a Fernet key before first boot!) ---
# Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=CHANGE_ME_GENERATE_32BYTE_FERNET_KEY

# --- FastAPI Application Server ---
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=False

# --- Timezones & Broker Clock Sync ---
DISPLAY_TIMEZONE=Asia/Kolkata
BROKER_TZ_OFFSET_SEC=7200

# --- Optional Telegram Fallbacks (Can also be configured in UI Settings) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Nginx Ports ---
HTTP_PORT=80
HTTPS_PORT=443

